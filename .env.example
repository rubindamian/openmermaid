# Copy to .env and adjust. Compose loads .env from this directory.
# Do not commit real secrets.

# Django
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-local-only
DJANGO_READ_DOT_ENV_FILE=true
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
USE_DOCKER=yes

# Split origins (frontend image is independent; added in a later unit)
# Browser studio origin. CORS and CSRF trusted origins are derived from this.
FRONTEND_ORIGIN=http://localhost:3000
# Public API origin the frontend will call (credentialed fetch).
PUBLIC_API_ORIGIN=http://localhost:8082

# Google OAuth. Restrict to Workspace via the ID-token `hd` claim plus this allowlist.
# Create a Web client whose authorized redirect URI matches GOOGLE_OAUTH_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8082/auth/complete/google-oauth2/
GOOGLE_WORKSPACE_DOMAINS=example.com

# PostgreSQL
# ------------------------------------------------------------------------------
# Host and port are deliberately absent: this file is shared by host tooling and
# Compose. Host runs (pytest, manage.py) fall back to localhost:5433, and Compose
# overrides the backend container to postgres:5432.
POSTGRES_DB=openmermaid
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
