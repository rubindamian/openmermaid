		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.0.0",
		"vite": "^7.0.4",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"flowbite": "^4.0.2",
